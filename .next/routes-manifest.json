{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/companies/[slug]",
      "regex": "^/api/companies/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/api/companies/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/problems/[slug]",
      "regex": "^/api/problems/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/api/problems/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/problems/[slug]/run",
      "regex": "^/api/problems/([^/]+?)/run(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/api/problems/(?<nxtPslug>[^/]+?)/run(?:/)?$"
    },
    {
      "page": "/api/problems/[slug]/submit",
      "regex": "^/api/problems/([^/]+?)/submit(?:/)?$",
